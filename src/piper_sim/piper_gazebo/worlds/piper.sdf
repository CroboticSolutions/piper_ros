<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="piper_world">

    <!-- Physics -->
    <physics name="1ms" type="ignition.physics.sim" default="true">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    <gravity>0 0 -9.81</gravity>
    </plugin>
   

    <!-- Scene -->
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- User Commands (for interaction) -->
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>

    <!-- Sensors (updates sensors + publishes sensor topics) -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
    <!-- optional: render engine selection -->
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Rendering -->
    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <grid>false</grid>
    </scene>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>100 100 0.01</size>
            </box>
          </geometry>
          <pose>0 0 -0.005 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>5 5 0.01</size>
            </box>
          </geometry>
          <pose>0 0 -0.005 0 0 0</pose>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>file:///root/arms_ws/install/piper_gazebo/share/piper_gazebo/materials/textures/wood_texture.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Red cube in front of the Piper base. -->
    <model name="red_cube">
      <static>false</static>
      <pose>0.5 0 0.025 0 0 0</pose>
      <link name="link">
        <!-- Light, graspable body. Without an explicit inertial a dynamic link
             gets an undefined/unit mass and behaves erratically under grasp. -->
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.083e-5</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>2.083e-5</iyy>
            <iyz>0</iyz>
            <izz>2.083e-5</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <!-- High friction + soft contact so the gripper fingers grip the
               cube instead of squeezing it out. Pairs with the piper link7/link8
               finger surface tuning. -->
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1e+5</kp>
                <kd>1</kd>
                <min_depth>0.001</min_depth>
                <max_vel>0</max_vel>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>0.2 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
