<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper">
  <xacro:arg name="simulation" default="true"/>
  <xacro:arg name="simulation_controllers" default=""/>
  <xacro:arg name="wrist_camera" default="gazebo_realsense"/>
  <!-- Real Femto Bolt mount since 2026-10-05 is on link5 (does not rotate with joint 6).
       Simulation keeps link6 because its nominal extrinsics are expressed there. -->
  <xacro:arg name="femto_parent_link" default="link5"/>
  <xacro:include filename="$(find piper_description)/urdf/piper_no_gripper_description_gz.xacro"/>

  <!-- AgileX PiPER flange (STL in mm): mounting face on link6 at Z=0, top recess Ø40.5 x 6 mm. -->
  <link name="piper_flange">
    <visual>
      <geometry><mesh filename="package://piper_description/meshes/welding_gun/AgileX_PiPER_Flange.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="piper_flange_metal"><color rgba="0.55 0.57 0.60 1"/></material>
    </visual>
    <!-- Real robot: end effector excluded from collision checking (operator request 2026-10-05). -->
    <xacro:if value="$(arg simulation)">
      <collision>
        <geometry><mesh filename="package://piper_description/meshes/welding_gun/AgileX_PiPER_Flange.stl" scale="0.001 0.001 0.001"/></geometry>
      </collision>
    </xacro:if>
    <inertial>
      <origin xyz="0 0 0.0044"/>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00002"/>
    </inertial>
  </link>
  <joint name="piper_flange_mount" type="fixed">
    <parent link="link6"/><child link="piper_flange"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <!-- Welding gun frame stays identical to link6 so arm_tcp and calibrations keep their
       values. The gun STL (mm) is modelled lying along -Y: its Ø39 spigot (y 47.8..54,
       axis x=-5.85, z=28.5) sits in the flange recess, face y=47.8 on the flange top
       (z=10.5 mm); the wire bend points to link6 +X, which matches the 2026-10-05 TCP
       calibration within ~3.5 mm. -->
  <link name="piper_welding_gun">
    <visual>
      <origin xyz="0.00585 -0.0285 0.0583" rpy="-1.5707963268 0 0"/>
      <geometry><mesh filename="package://piper_description/meshes/welding_gun/03_welding_gun.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="piper_gun_metal"><color rgba="0.35 0.38 0.42 1"/></material>
    </visual>
    <xacro:if value="$(arg simulation)">
      <collision>
        <origin xyz="0.00585 -0.0285 0.0583" rpy="-1.5707963268 0 0"/>
        <geometry><mesh filename="package://piper_description/meshes/welding_gun/03_welding_gun.stl" scale="0.001 0.001 0.001"/></geometry>
      </collision>
    </xacro:if>
    <!-- Approximate prototype dynamics; no measured mass supplied with STL. -->
    <inertial>
      <origin xyz="0.004 0 0.04"/>
      <mass value="0.35"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0003"/>
    </inertial>
  </link>
  <joint name="piper_welding_gun_mount" type="fixed">
    <parent link="piper_flange"/><child link="piper_welding_gun"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <!-- Nominal CAD wire-tip TCP, applied 2026-09-30. TCP +X follows the wire. -->
  <link name="arm_tcp"/>
  <joint name="arm_tcp_joint" type="fixed">
    <parent link="piper_welding_gun"/><child link="arm_tcp"/>
    <!-- Wire tip of 03_welding_gun.stl on the AgileX flange (model geometry, 2026-10-05):
         end-face centre of the Ø3 mm wire, axis 45.3 deg from link6 Z toward +X.
         TCP +X follows the wire. Same for real robot and simulation. -->
    <origin xyz="0.039746665881 -0.000003287520 0.111796185844" rpy="0 -0.7801056516 0"/>
  </joint>
  <xacro:if value="${'$(arg wrist_camera)' == 'femto_bolt'}">
    <xacro:include filename="$(find piper_description)/urdf/include/piper_femto_bolt_handeye_macros.xacro"/>
    <xacro:piper_mount_femto_bolt_handeye parent_link="${'link6' if '$(arg simulation)' == 'true' else '$(arg femto_parent_link)'}"
                                         use_nominal_extrinsics="$(arg simulation)"/>
  </xacro:if>
  <xacro:unless value="${'$(arg wrist_camera)' == 'femto_bolt'}">
    <xacro:include filename="$(find piper_description)/urdf/include/piper_realsense_d435_handeye_macros.xacro"/>
    <xacro:piper_mount_realsense_d435_handeye parent_link="link6"/>
  </xacro:unless>
  <!-- Preserve the existing simulated-camera topic/frame API used by the GUI. -->
  <!-- Driver-owned Femto optical frames are not links in the real URDF. -->
  <xacro:if value="${'$(arg simulation)' == 'true' or '$(arg wrist_camera)' != 'femto_bolt'}">
  <link name="oak_right_camera_optical_frame"/>
  <joint name="piper_sim_optical_alias" type="fixed">
    <parent link="camera_color_optical_frame"/><child link="oak_right_camera_optical_frame"/>
  </joint>
  </xacro:if>
  <xacro:if value="$(arg simulation)">
  <xacro:include filename="$(find piper_description)/urdf/include/d435_gazebo_sensors.xacro"/>
  <xacro:d435_gazebo_sensors/>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg simulation_controllers)</parameters>
      <hold_joints>true</hold_joints><position_proportional_gain>0.1</position_proportional_gain>
    </plugin>
  </gazebo>
  </xacro:if>
</robot>
