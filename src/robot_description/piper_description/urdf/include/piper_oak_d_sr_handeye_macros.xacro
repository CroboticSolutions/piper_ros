<?xml version="1.0"?>
<!--
  Piper + OAK-D-SR fragments (included via xacro:include from piper_description_*_gz.xacro).

  Outer <robot> wrapper is stripped by xacro; only macros and nested includes apply.

  Calibration: ~/.ros/hand_eye_calibration.yaml (eye-in-hand: link6 → oak_right_camera_optical_frame).

  Mount pose is solved so the full kinematic chain matches the YAML calibration:
    T(link6→optical) = T_yaml  = T(mount: link6→oak-d-base-frame) × T_nominal(OAK-D-SR right cam)

  where T_nominal = trans(0,-0.01,0) × rot(rpy = -π/2, 0, -π/2 intrinsic xyz, same convention as depthai_macro).

  If you save a NEW calibration or change camera_model, recreate the fixed joint numeric values this way.

  Updated from saved YAML (handeye_depthai_mount_args / same T_mount math).
  piper_description.xacro passes oak_visual_mesh:=false for MoveIt/RViz (no depthai STL mesh; TF unchanged).

  Still do not run hand_eye_calibration/publish.launch simultaneously (duplicate TF).

  Hand-eye estimate (link6→oak_right_camera_optical_frame): tx ty tz qx qy qz qw =
    -0.0916 -0.0015 0.0632 0.1157 -0.1322 0.7206 -0.6708

  link6 → oak-d-base-frame (REP-103 URDF roll-pitch-yaw = intrinsic XYZ):
    xyz = -0.090866253 0.008472480 0.063306116
    rpy = 0.030685051 -1.217622058 -0.102237087
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="piper_oak_attachment_defs">

  <!--
    oak_visual_mesh=false: same TF tree as depthai OAK-D-SR but skip STL mesh on oak_model_origin (lighter RViz/MoveIt).
    Defaults true for Gazebo / users who want the visual housing.
  -->
  <xacro:macro name="piper_mount_oak_d_sr_handeye" params="parent_link simulation:=false oak_gazebo_rgbd_sensor:=false oak_visual_mesh:=true">
    <link name="oak-d-base-frame"/>
    <joint name="piper_hand_eye_link6_mount" type="fixed">
      <origin
        xyz="-0.090866253 0.008472480 0.063306116"
        rpy="0.030685051 -1.217622058 -0.102237087"/>
      <parent link="${parent_link}" />
      <child link="oak-d-base-frame" />
    </joint>

    <xacro:if value="${oak_visual_mesh}">
    <xacro:include filename="$(find depthai_descriptions)/urdf/include/depthai_macro.urdf.xacro"/>
    <xacro:depthai_camera
      camera_name="oak"
      parent="oak-d-base-frame"
      camera_model="OAK-D-SR"
      base_frame="oak-d_frame"
      cam_pos_x="0.0"
      cam_pos_y="0.0"
      cam_pos_z="0.0"
      cam_roll="0.0"
      cam_pitch="0.0"
      cam_yaw="0.0"
      simulation="${simulation}"
      rs_compat="false"/>
    </xacro:if>

    <!-- Mirrors depthai base_macro + OAK-D-SR stereo branch; omits oak_model_origin mesh link -->
    <xacro:unless value="${oak_visual_mesh}">
      <xacro:property name="oak_sr_pi" value="3.1415926535897931"/>
      <xacro:property name="oak_sr_half_base" value="0.01"/>
      <link name="oak-d_frame"/>
      <joint name="oak_center_joint" type="fixed">
        <parent link="oak-d-base-frame"/>
        <child link="oak-d_frame"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>
      <link name="oak_left_camera_frame"/>
      <joint name="oak_left_camera_joint" type="fixed">
        <parent link="oak-d_frame"/>
        <child link="oak_left_camera_frame"/>
        <origin xyz="0 ${oak_sr_half_base} 0" rpy="0 0 0"/>
      </joint>
      <link name="oak_left_camera_optical_frame"/>
      <joint name="oak_left_camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-${oak_sr_pi/2} 0 -${oak_sr_pi/2}"/>
        <parent link="oak_left_camera_frame"/>
        <child link="oak_left_camera_optical_frame"/>
      </joint>
      <link name="oak_right_camera_frame"/>
      <joint name="oak_right_camera_joint" type="fixed">
        <parent link="oak-d_frame"/>
        <child link="oak_right_camera_frame"/>
        <origin xyz="0 -${oak_sr_half_base} 0" rpy="0 0 0"/>
      </joint>
      <link name="oak_right_camera_optical_frame"/>
      <joint name="oak_right_camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-${oak_sr_pi/2} 0 -${oak_sr_pi/2}"/>
        <parent link="oak_right_camera_frame"/>
        <child link="oak_right_camera_optical_frame"/>
      </joint>
    </xacro:unless>

    <xacro:if value="${oak_gazebo_rgbd_sensor}">
    <gazebo reference="oak_right_camera_frame">
      <sensor name="camera" type="rgbd_camera">
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
        </camera>
        <depth_camera>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>10.0</far>
          </clip>
          <point_cloud>true</point_cloud>
        </depth_camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
      </sensor>
    </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
