<?xml version="1.0"?>
<!--
  Piper + Orbbec Femto Bolt (eye-in-hand; mount on link5 since 2026-10-05, real
  and simulation).

  The mount origin (parent_link -> camera_base_link) is NOT written here. It is
  loaded from calibration_file, a YAML with a `real` and a `nominal` origin:
    - normally the robot's active calibration
      ~/.ros/calibration/<robot_id>/femto_bolt_handeye/current.yaml, written by
      GUI Apply / handeye_welding_gun_apply (hand_eye_calibration/calibration_store.py);
    - otherwise piper_description/config/calibration/femto_bolt_handeye_default.yaml.
  Real: the optical pose re-expressed through the driver's own depth->colour
  extrinsics. Nominal (simulation): the same optical pose through the nominal
  chain of orbbec_description's femto_bolt macro, so both optical frames match.

  Frame names match orbbec_camera's femto_bolt.launch.py defaults (camera_name:=camera):
    camera_base_link, camera_link, camera_color_optical_frame, etc.

  Real hardware: robot_state_publisher owns only the mount through camera_link.
  The Orbbec driver owns all internal camera TFs (publish_tf:=true).
  Simulation uses nominal internal transforms because no camera driver runs.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="piper_femto_bolt_attachment_defs">

  <xacro:macro name="piper_mount_femto_bolt_handeye" params="parent_link calibration_file use_nominal_extrinsics:=false">
    <xacro:property name="femto_cal" value="${xacro.load_yaml(calibration_file)}"/>
    <xacro:property name="femto_origin" value="${femto_cal['nominal'] if use_nominal_extrinsics else femto_cal['real']}"/>
    <xacro:include filename="$(find orbbec_description)/urdf/femto_bolt.urdf.xacro"/>
    <xacro:femto_bolt prefix="camera" parent="${parent_link}" use_nominal_extrinsics="${use_nominal_extrinsics}">
      <origin xyz="${femto_origin['xyz']}" rpy="${femto_origin['rpy']}"/>
    </xacro:femto_bolt>
  </xacro:macro>

</robot>
