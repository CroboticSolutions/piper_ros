  </gazebo>
  <gazebo reference="link8">
      <selfCollide>false</selfCollide>
  </gazebo>

  <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <joint name="joint1">
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <command_interface name="effort"/>
          <state_interface name="position">
              <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity">
              <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="effort">
              <param name="initial_value">0.0</param>
          </state_interface>
      </joint>
      <joint name="joint2">
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <command_interface name="effort"/>
          <state_interface name="position">
              <param name="initial_value">0.1</param>
          </state_interface>
          <state_interface name="velocity">
              <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="effort">
              <param name="initial_value">0.0</param>
          </state_interface>
      </joint>
      <joint name="joint3">
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <command_interface name="effort"/>
          <state_interface name="position">
              <param name="initial_value">-1.5</param>
          </state_interface>
          <state_interface name="velocity">
              <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="effort">
              <param name="initial_value">0.0</param>
          </state_interface>
      </joint>
      <joint name="joint4">
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <command_interface name="effort"/>
          <state_interface name="position">
              <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity">
              <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="effort">
              <param name="initial_value">0.0</param>
          </state_interface>
      </joint>
      <joint name="joint5">
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <command_interface name="effort"/>
          <state_interface name="position">
              <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity">
              <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="effort">
              <param name="initial_value">0.0</param>
          </state_interface>
      </joint>
      <joint name="joint6">
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <command_interface name="effort"/>
          <state_interface name="position">
              <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity">
              <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="effort">
              <param name="initial_value">0.0</param>
          </state_interface>
      </joint>
      <joint name="joint7">
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <command_interface name="effort"/>
          <state_interface name="position">
              <param name="initial_value">0.0175</param>
          </state_interface>
          <state_interface name="velocity">
              <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="effort">
              <param name="initial_value">0.0</param>
          </state_interface>
      </joint>
      <joint name="joint8">
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <command_interface name="effort"/>
          <state_interface name="position">
              <param name="initial_value">-0.0175</param>
          </state_interface>
          <state_interface name="velocity">
              <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="effort">
              <param name="initial_value">0.0</param>
          </state_interface>
      </joint>
  </ros2_control>

  <!-- Camera -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.01" />
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.02 0.04 0.02" />
      </geometry>
      <material name="camera_black">
        <color rgba="0.0 0.0 0.0 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.02 0.04 0.02" />
      </geometry>
    </collision>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="link6"/>
    <child link="camera_link"/>
    <origin xyz="-0.05 0 0.02" rpy="0 -1.5708 0"/>
  </joint>

  <!-- Gazebo (Gz) RGB-D camera sensor -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="rgbd_camera">
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
      </camera>
      <depth_camera>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>10.0</far>
        </clip>
        <point_cloud>true</point_cloud>
      </depth_camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
    </sensor>
  </gazebo>
  <!-- Camera optical frame (ROS convention: X right, Y down, Z forward) -->
  <link name="camera_optical_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.0001" />
      <inertia ixx="0.00000001" ixy="0.0" ixz="0.0" iyy="0.00000001" iyz="0.0" izz="0.00000001" />
    </inertial>
  </link>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <!-- optical: X right, Y down, Z forward (ROS REP 103 standard) -->
    <!-- This is independent of camera mount - converts to optical convention -->
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>


</robot>
