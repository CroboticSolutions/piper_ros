      upper="1.22"
      effort="100"
      velocity="5" />
    <dynamics
      damping="0"
      friction="0" />
  </joint>
  <link
    name="link6">
    <inertial>
            <origin xyz="-8.82590762930069E-05 9.0598378529832E-06 -0.002" rpy="0 0 0" />
            <mass value="0.00699089613564366" />
            <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001" />
    </inertial>
    <visual>
      <origin
