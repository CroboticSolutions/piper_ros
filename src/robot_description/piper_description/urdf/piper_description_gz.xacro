    <origin
      xyz="0 0 0.1358"
      rpy="1.5708 0 0" />
    <parent
      link="gripper_base" />
    <child
      link="link7" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="0"
      upper="0.035"
      effort="10"
      velocity="1" />
    <dynamics
      damping="0"
      friction="0" />
  </joint>

  <link
    name="link8">
    <inertial>
      <origin
        xyz="0.000651231850419722 -0.0491929869131991 0.00972258769184024"
        rpy="0 0 0" />
      <mass
